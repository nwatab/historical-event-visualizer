{
  "name": "historical-event-visualizer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "copy-maplibre-worker": "node scripts/copy-maplibre-worker.mjs",
    "dev": "pnpm copy-maplibre-worker && next dev",
    "build": "pnpm copy-maplibre-worker && next build",
    "lint": "eslint .",
    "wikidata:fetch": "node scripts/wikidata/fetch.mjs",
    "wikidata:fetch-lists": "node scripts/wikidata/fetch-lists.mjs",
    "wikidata:fetch-app-extras": "node scripts/wikidata/fetch-app-extras.mjs",
    "wikidata:fetch-places": "node scripts/wikidata/fetch-places.mjs",
    "wikidata:report": "node scripts/wikidata/report.mjs",
    "wikidata:build-app-data": "node scripts/wikidata/build-app-data.mjs",
    "wikidata:place-overrides-draft": "node scripts/wikidata/build-place-overrides-draft.mjs",
    "wikidata:diffusion-draft": "node scripts/wikidata/build-diffusion-draft.mjs"
